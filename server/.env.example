PORT=8080
APP_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5434/warrantykeeper?sslmode=disable
JWT_SECRET=dev-secret-change-me

# Optional: set one of these to use a real OCR provider instead of the stub
# (always low-confidence, requires manual entry). If both are set, Gemini
# takes priority. Gemini is the free option -- Google AI Studio
# (aistudio.google.com) issues free-tier keys with no credit card required.
# GEMINI_API_KEY=
# GEMINI_OCR_MODEL=gemini-3.6-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_OCR_MODEL=claude-haiku-4-5-20251001
